{
    "compilerOptions": {
        "target": "es2022",
        "lib": [
            "ES2023"
        ],
        "types": [
            "jest",
            "mocha"
        ],
        "paths": {},
        "module": "esnext",
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true
    }
}